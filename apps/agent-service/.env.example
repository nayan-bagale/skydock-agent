# Copy to .env and adjust. The agent loads this file from apps/agent-service.

# Directories to watch and seed as sync roots. Comma-separated.
SKYDOCK_WATCH_DIRS=/path/to/watch

# SQLite file. Empty uses the OS default:
# macOS: ~/Library/Application Support/SkyDock/database/skydock.sqlite3
SKYDOCK_DB_PATH=

# ZeroMQ endpoint. Desktop reads the same variable.
SKYDOCK_AGENT_ZMQ_URL=ipc:///tmp/skydock-agent.sock
