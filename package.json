{
  "name": "skydock-agent",
  "packageManager": "yarn@4.14.1",
  "engines": {
    "node": ">=20.0.0 <24.0.0"
  },
  "private": true,
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/verify-electron.mjs",
    "agent:dev": "cd apps/agent-service && go run .",
    "desktop:dev": "yarn workspace desktop dev",
    "desktop:build": "yarn workspace desktop build",
    "desktop:lint": "yarn workspace desktop lint",
    "desktop:typecheck": "yarn workspace desktop typecheck"
  }
}
